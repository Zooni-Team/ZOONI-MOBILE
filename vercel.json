{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd zooni-app && npm install",
  "buildCommand": "cd zooni-app && npm run build:web",
  "outputDirectory": "zooni-app/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/lugares.js": {
      "maxDuration": 30
    }
  }
}
