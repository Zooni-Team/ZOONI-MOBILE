# supabase/functions/.env.example — Secrets de las Edge Functions.
#
# Son SECRETOS: nunca van en el repo ni en zooni-app/.env. Se cargan en
# Supabase con:
#   supabase secrets set GROQ_API_KEY=gsk_...
# (o Dashboard → Edge Functions → Secrets). Para probar local:
#   cp supabase/functions/.env.example supabase/functions/.env   (está en .gitignore)
#   supabase functions serve --env-file supabase/functions/.env

# zoonivet-chat — clave de Groq (https://console.groq.com/keys). SECRETA.
GROQ_API_KEY=gsk_ejemplo_no_real

# zoonivet-chat — modelo principal y de respaldo (opcionales).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY NO se configuran: Supabase los
# inyecta solos en cada Edge Function. La service_role key es SECRETA y saltea
# RLS: jamás debe estar en la app.
