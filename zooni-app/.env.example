# zooni-app/.env — copiá este archivo como .env y completá los valores.
# En Expo, solo las variables con prefijo EXPO_PUBLIC_ llegan al bundle del
# cliente en tiempo de ejecución (process.env.*).

# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Groq (ZooniVet) ─────────────────────────────────────────────────────────
# Key de la API de Groq (https://console.groq.com/keys). La usa el chatbot
# ZooniVet para responder. Se lee en src/config/groq.js.
EXPO_PUBLIC_GROQ_API_KEY=

# Modelo a usar (opcional). Por defecto: openai/gpt-oss-120b.
# El identificador va en env para poder cambiarlo ante una deprecación de Groq
# sin publicar una versión nueva de la app.
EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
EXPO_PUBLIC_GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
