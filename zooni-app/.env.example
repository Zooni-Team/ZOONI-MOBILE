# zooni-app/.env.example — Copiar a zooni-app/.env y completar.
#
# ⚠ TODO lo que empieza con EXPO_PUBLIC_ queda escrito dentro del bundle que
#   descarga cualquiera (web y apps). Acá van SOLO valores públicos por diseño.
#   Nunca pongas acá una clave secreta (service_role, Groq, etc.): esas viven
#   como secrets de las Edge Functions (ver supabase/functions/.env.example).

# URL del proyecto de Supabase (Project Settings → API → Project URL). PÚBLICA.
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publicable de Supabase (Project Settings → API Keys → Publishable key).
# PÚBLICA por diseño: no protege nada sola; lo que protege los datos es la
# sesión de Supabase Auth + las políticas RLS de supabase/migrations/061.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ejemplo_no_real

# Opcional. Google Places para sumar veterinarias/pet shops reales al mapa de
# Comunidad. Sin ella se usa OpenStreetMap (gratis, sin clave).
# PÚBLICA (viaja en el bundle): restringila en Google Cloud Console por
# dominio (HTTP referrer) y a la API "Places" solamente.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
