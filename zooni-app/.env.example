# zooni-app/.env — copiá este archivo como .env y completá los valores.
# En Expo, solo las variables con prefijo EXPO_PUBLIC_ llegan al bundle del
# cliente en tiempo de ejecución (process.env.*).

# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Groq (ZooniVet) ─────────────────────────────────────────────────────────
# La API key de Groq YA NO va acá: vive como secret de la Edge Function
# `zoonivet-chat` (supabase/functions/zoonivet-chat) para que nunca llegue al
# bundle del cliente. Configurala una sola vez con:
#
#   supabase secrets set GROQ_API_KEY=gsk_...
#   supabase secrets set GROQ_MODEL=openai/gpt-oss-120b          # opcional
#   supabase secrets set GROQ_MODEL_FALLBACK=openai/gpt-oss-20b  # opcional
#
# y deployá la función con:  supabase functions deploy zoonivet-chat
