# Variables de entorno de zooni-app (Expo)
# ------------------------------------------------------------------
# Copiá este archivo a `.env` y completá los valores reales.
# El `.env` está en .gitignore: NO se sube al repo.
#
# Las variables con prefijo EXPO_PUBLIC_ se inyectan en el bundle en
# tiempo de build. Para el deploy web en Vercel hay que cargarlas también
# en: Project -> Settings -> Environment Variables.

# ── Supabase ──────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Groq (IA de ZooniVet) ─────────────────────────────────────────
EXPO_PUBLIC_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Opcionales (tienen valor por defecto en src/config/groq.js):
# EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
# EXPO_PUBLIC_GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
